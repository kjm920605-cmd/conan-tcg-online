{
  "purpose": "Reviewed settings for manual Railway Dashboard application; NOT an auto-consumed Railway config file",
  "project": "Conan TCG Closed Alpha",
  "environment": "production",
  "repository": "https://github.com/kjm920605-cmd/conan-tcg-online",
  "branch": "main",
  "applied": false,
  "services": {
    "web": {
      "rootDirectory": "/",
      "dockerfile": "deploy/web.Dockerfile",
      "buildCommandOverride": null,
      "startCommand": "node apps/web/index.ts",
      "preDeployCommand": null,
      "healthcheckPath": "/ready",
      "healthcheckTimeoutSeconds": 120,
      "replicas": 1,
      "serverless": false,
      "autoDeploy": false,
      "watchPaths": ["src/**", "apps/**", "packages/**", "data/**", "db/**", "scripts/**", "tests/**", "e2e/**", "examples/**", "*.json", "*.ts", "*.yaml", "Dockerfile", ".dockerignore", "deploy/**"]
    },
    "server": {
      "rootDirectory": "/",
      "dockerfile": "Dockerfile",
      "buildCommandOverride": null,
      "startCommand": "node apps/server/index.ts",
      "preDeployCommand": "node scripts/migrate.ts",
      "healthcheckPath": "/ready",
      "healthcheckTimeoutSeconds": 120,
      "replicas": 1,
      "serverless": false,
      "autoDeploy": false,
      "releasePolicy": "Remove the previous server deployment and verify it stopped before deploying a selected main revision",
      "watchPaths": ["src/**", "apps/**", "packages/**", "data/**", "db/**", "scripts/**", "tests/**", "e2e/**", "examples/**", "*.json", "*.ts", "*.yaml", "Dockerfile", ".dockerignore", "deploy/**"]
    },
    "PostgreSQL": {
      "provisioning": "Railway PostgreSQL service in the same project and environment",
      "applicationConnection": "server DATABASE_URL references PostgreSQL DATABASE_URL via Railway Variables",
      "publicTcpProxy": false
    }
  }
}
