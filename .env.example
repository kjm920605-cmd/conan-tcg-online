# Placeholders only. Supply values using the platform secret store or an ignored private env file.
NODE_ENV=production
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=verify-full
DATABASE_SCHEMA=public
MATCH_STORAGE=postgres
HOST=0.0.0.0
PORT=8787
WEB_PUBLIC_URL=https://YOUR_WEB_PUBLIC_HOST
GAME_SERVER_PUBLIC_URL=wss://YOUR_SERVER_PUBLIC_HOST/ws
CORS_ORIGINS=https://YOUR_WEB_PUBLIC_HOST
ALPHA_TRANSPORT=TICKET
SESSION_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_64_HEX_VALUE
ALPHA_ACCESS_SECRET=REPLACE_WITH_ANOTHER_RANDOM_64_HEX_VALUE
ALPHA_TTL_SECONDS=28800
TRUST_PROXY=false
LOG_LEVEL=info
# Behind the supplied private reverse proxy, set TRUST_PROXY=true.
# Set Railway PORT to match the public domain target port (server: 8787).
# For the retained same-origin topology, set ALPHA_TRANSPORT=COOKIE and matching public hosts.
# Optional direct Node HTTPS: set BOTH TLS_KEY_FILE and TLS_CERT_FILE using mounted private files.
# TLS_KEY_FILE=/run/secrets/TLS_PRIVATE_KEY_FILE
# TLS_CERT_FILE=/run/secrets/TLS_CERTIFICATE_CHAIN_FILE
