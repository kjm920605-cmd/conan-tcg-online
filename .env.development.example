# Development only. Use your local PostgreSQL connection and binding values.
NODE_ENV=development
DATABASE_URL=postgresql://DEV_DB_USER:DEV_DB_PASSWORD@DEV_DB_HOST:5432/DEV_DB_NAME
DATABASE_SCHEMA=public
MATCH_STORAGE=postgres
HOST=DEV_BIND_ADDRESS
PORT=8787
LOG_LEVEL=info
