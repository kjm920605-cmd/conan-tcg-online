# Standalone Web runtime. Public placeholders only; no database or signing/access secrets.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
WEB_PUBLIC_URL=https://YOUR_WEB_PUBLIC_HOST
GAME_SERVER_PUBLIC_URL=wss://YOUR_SERVER_PUBLIC_HOST/ws
LOG_LEVEL=info
TRUST_PROXY=true
PROXY_IP_HEADER=X_REAL_IP
# Set Railway PORT to match the public domain target port (web: 8080).
# Set Dashboard Dockerfile Path to deploy/web.Dockerfile.
# Only enable this proxy mode behind Railway edge, with no public app/TCP bypass port.
